@model List<TANA.Models.BankAccount>
    @{
    Layout = "_ReportLayout";
    }
    <div id="report-title"><h1>Bank Account</h1></div>
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>User Id</th>
                <th>Bank Name</th>
                <th>Account Name</th>
                <th>Fund Name</th>
                <th>Debit Amount</th>
                <th>Date Transaction</th>
                <th>Frequency Deduction</th>
                <th>End Date</th>
                <th>Date Created</th>
                <th>Date Updated</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var record in Model)
            {
            <tr>
                <td>@record.id</td>
                <td>@record.user_id</td>
                <td>@record.bank_name</td>
                <td>@record.account_name</td>
                <td>@record.fund_name</td>
                <td>@record.debit_amount</td>
                <td>@record.date_transaction</td>
                <td>@record.frequency_deduction</td>
                <td>@record.end_date</td>
                <td>@record.date_created</td>
                <td>@record.date_updated</td>
            </tr>
            }
        </tbody>
    </table>