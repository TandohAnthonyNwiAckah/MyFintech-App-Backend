@model List<TANA.Models.ProductName>
    @{
    Layout = "_ReportLayout";
    }
    <div id="report-title"><h1>Product Name</h1></div>
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Date Created</th>
                <th>Date Updated</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var record in Model)
            {
            <tr>
                <td>@record.id</td>
                <td>@record.name</td>
                <td>@record.date_created</td>
                <td>@record.date_updated</td>
            </tr>
            }
        </tbody>
    </table>