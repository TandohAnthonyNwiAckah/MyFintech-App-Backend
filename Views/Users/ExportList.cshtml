@model List<TANA.Models.Users>
    @{
    Layout = "_ReportLayout";
    }
    <div id="report-title"><h1>Users</h1></div>
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Firstname</th>
                <th>Middlename</th>
                <th>Surname</th>
                <th>Maiden Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Photo</th>
                <th>Dob</th>
                <th>Gender</th>
                <th>Digital Address</th>
                <th>Residential Status</th>
                <th>Country</th>
                <th>User Role Id</th>
                <th>Date Created</th>
                <th>Date Updated</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var record in Model)
            {
            <tr>
                <td>@record.id</td>
                <td>@record.title</td>
                <td>@record.firstname</td>
                <td>@record.middlename</td>
                <td>@record.surname</td>
                <td>@record.maiden_name</td>
                <td>@record.phone</td>
                <td>@record.email</td>
                <td>@record.photo</td>
                <td>@record.dob</td>
                <td>@record.gender</td>
                <td>@record.digital_address</td>
                <td>@record.residential_status</td>
                <td>@record.country</td>
                <td>@record.user_role_id</td>
                <td>@record.date_created</td>
                <td>@record.date_updated</td>
            </tr>
            }
        </tbody>
    </table>