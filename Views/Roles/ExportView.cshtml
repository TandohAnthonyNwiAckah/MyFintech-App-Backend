@model List<TANA.Models.Roles>
    @{
    Layout = "_ReportLayout";
    var record = Model.First();
    }
    <div id="report-title"><h1>Role Details</h1></div>
    <table class="table table-sm table-striped">
        <tbody>
            <tr>
                <th>Role Id</th>
                <td>@record.role_id</td>
            </tr>
            <tr>
                <th>Role Name</th>
                <td>@record.role_name</td>
            </tr>
            <tr>
                <th>Date Created</th>
                <td>@record.date_created</td>
            </tr>
            <tr>
                <th>Date Updated</th>
                <td>@record.date_updated</td>
            </tr>
        </tbody>
    </table>