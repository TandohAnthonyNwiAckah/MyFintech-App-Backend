@model List<TANA.Models.Audits>
    @{
    Layout = "_ReportLayout";
    }
    <div id="report-title"><h1>Audits</h1></div>
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Log Id</th>
                <th>Action</th>
                <th>Page</th>
                <th>Record Id</th>
                <th>User Id</th>
                <th>User Ip</th>
                <th>User Agent</th>
                <th>Request Url</th>
                <th>Old Values</th>
                <th>New Values</th>
                <th>Timestamp</th>
                <th>Date Created</th>
                <th>Date Updated</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var record in Model)
            {
            <tr>
                <td>@record.log_id</td>
                <td>@record.action</td>
                <td>@record.page</td>
                <td>@record.record_id</td>
                <td>@record.user_id</td>
                <td>@record.user_ip</td>
                <td>@record.user_agent</td>
                <td>@record.request_url</td>
                <td>@record.old_values</td>
                <td>@record.new_values</td>
                <td>@record.timestamp</td>
                <td>@record.date_created</td>
                <td>@record.date_updated</td>
            </tr>
            }
        </tbody>
    </table>